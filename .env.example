# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/stackpoker"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-min-64-chars-replace-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars-replace-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Apple Sign In
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_CLIENT_ID="com.yourcompany.stackpoker"
APPLE_KEY_ID="YOUR_KEY_ID"
APPLE_PRIVATE_KEY_PATH="./apple_auth_key.p8"

# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3001"

# Logging
LOG_LEVEL=debug

# Starting chips for new users
SIGNUP_BONUS_CHIPS=10000
DAILY_BONUS_CHIPS=1000
